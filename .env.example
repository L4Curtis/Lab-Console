# ─────────────────────────────────────────────────────────────────────────────
# Lab Console configuration
# Copy to .env and fill in the values
# ─────────────────────────────────────────────────────────────────────────────

# ── Web server ───────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
# Public address of the platform, as users type it: scheme and host, no path.
# Required: sign-in redirects and cookie security derive from it (https gives
# the session cookie the __Host- prefix and Secure)
PUBLIC_URL=
# Reverse proxies (nginx, Traefik, a CDN…) whose X-Forwarded-For header is
# believed: comma list of IP addresses and CIDR blocks, IPv4 or IPv6. List
# EVERY hop in front of Lab Console: behind NPM and then Cloudflare, NPM's
# address AND Cloudflare's published ranges (see docs/v2/AUTH.md). Everyone
# else's header is ignored, so nobody can fake their address.
# Empty = the platform is reached directly.   e.g. 192.168.10.112,172.16.0.0/12
# (The upstream TRUST_PROXY=true is refused at start-up: remove it.)
TRUSTED_PROXIES=
# Language of the interface on a first visit: fr or en. Each user can switch;
# the choice is remembered in their browser
DEFAULT_LOCALE=fr
# The diagram shipped with the platform. On the first start it is copied to
# DATA_DIR/diagrams/current.drawio, which is the active diagram from then on
# (replace it from Administration > Diagram, with versions and rollback)
DIAGRAM_PATH=./diagrams/diagram.drawio
# Where the platform keeps its state. The only directory it writes to; must
# be writable by the service account. Default ./data; the Docker image sets
# /data and expects a volume there. It holds the database lab-console.db
# (sessions, audit trail, settings, teams, the index of jobs and snapshots,
# the script library, device notes, bench chat…; SQLite, with its -wal and
# -shm files, mode 600) and the documents people download: configuration
# snapshots and TP templates, console journals, diagram versions. On the first start after an upgrade,
# the JSON / JSONL files of before (auth/*.json, audit/*.jsonl) are imported
# into the database and renamed *.imported, never deleted.
# Back it up service stopped, or with sqlite3's .backup while it runs.
# Needs Node.js 22.13 or later (built-in SQLite)
# DATA_DIR=./data

# ── Sign-in (see docs/v2/AUTH.md) ────────────────────────────────────────────
# There is no way to run without sign-in. The local administrator is
# mandatory: the platform refuses to start without these three lines.
# Generate them with:  npm run setup-admin   (password typed without echo)
# It is the emergency account: user name + password + a 6-digit code from an
# authenticator app, and it works when the identity provider is down
LOCAL_ADMIN_USERNAME=
LOCAL_ADMIN_PASSWORD_HASH=
LOCAL_ADMIN_TOTP_SECRET=

# OpenID Connect (optional): what students and teachers sign in with. Any
# standard provider: Pocket ID, Authentik, Keycloak, Authelia…
# Register a client with the callback URL  ${PUBLIC_URL}/auth/callback
# Leave OIDC_ISSUER empty to use the local administrator only
OIDC_ISSUER=
OIDC_CLIENT_ID=
# Empty = a public client (PKCE only). With a secret, how it is sent:
# client_secret_basic (default) or client_secret_post
OIDC_CLIENT_SECRET=
# OIDC_CLIENT_AUTH_METHOD=client_secret_basic
OIDC_SCOPES=openid profile email groups
# Where the provider puts the groups: a claim name or a dotted path
# (Keycloak: realm_access.roles). An array or a single string; looked up in
# the ID token first, then at the userinfo endpoint
OIDC_GROUPS_CLAIM=groups
# Members of these groups are administrators; everyone else is a student
OIDC_ADMIN_GROUPS=
# Empty = every account of the provider may sign in. Otherwise, only members
# of these groups (and of OIDC_ADMIN_GROUPS)
OIDC_ALLOWED_GROUPS=
# Label of the sign-in button ("Sign in with …")
OIDC_PROVIDER_NAME=SSO
# Plain-http issuers are refused except on localhost. true accepts one on a
# test bench (the mock provider of dev/mock-oidc.js); never with real accounts
# OIDC_ALLOW_INSECURE=false

# Encrypts the secrets saved from the administration pages: the SSO client
# secret ("Sign-in (SSO)" page) and the lab parameters' passwords and key
# ("Lab parameters" page), both kept in the database (DATA_DIR/lab-console.db).
# Optional: without it they are stored in clear in files only the service can
# read. At least 32 characters:  openssl rand -base64 48
# Changing or removing it makes the saved secret unreadable: set it again.
# APP_SECRET=

# ── Credential set 1: SSH jump server ────────────────────────────────────────
# The SSH_*, TELNET_*, ALLOWED_CONSOLE_HOSTS and ALLOWED_PORT_RANGE values are
# the starting point: Administration > Lab parameters can replace them without
# a restart (saved in the database, secrets encrypted with APP_SECRET when it
# is set)
SSH_HOST=<IP_ADDRESS>
SSH_PORT=<SSH_PORT>
SSH_USERNAME=<USERNAME>
SSH_PASSWORD=<PASSWORD>
# Optional, recommended: pin the jump server's host key
# Get it with:  ssh-keyscan -t ed25519 <IP_ADDRESS> | ssh-keygen -lf -
SSH_HOST_FINGERPRINT=
# Optional: key authentication instead of SSH_PASSWORD
# SSH_PRIVATE_KEY_PATH=./keys/id_ed25519
# SSH_KEY_PASSPHRASE=
# How the Proxmox tunnel crosses the jump server (device consoles are unaffected):
#   auto    - use TCP forwarding; if the jump server forbids it ("open failed" /
#             administratively prohibited), fall back to a relay command. Default.
#   forward - TCP forwarding only (needs AllowTcpForwarding on the jump server)
#   exec    - always run a relay command (socat/nc/bash), like the consoles do
# PROXMOX_TUNNEL_TRANSPORT=auto
# Optional explicit relay for exec/auto, with {host}/{port}. Empty = auto-detect
# (prefers socat, then ncat, nc, then bash /dev/tcp).
# PROXMOX_TUNNEL_RELAY=socat - TCP:{host}:{port}

# ── Credential set 2: Telnet console login ───────────────────────────────────
# Sent automatically to the first Username:/Password: prompt of a console line
# Leave TELNET_USERNAME empty for lines that only ask for a password
TELNET_USERNAME=<USERNAME_TELNET>
TELNET_PASSWORD=<PASSWORD_TELNET>
TELNET_AUTOLOGIN=true
# Silent console lines get one Enter after this much idle time (ms), but only
# if no login:/Password:/device prompt is visible (0 disables the nudge)
TELNET_WAKE_IDLE_MS=2500

# ── Which consoles may be reached ────────────────────────────────────────────
# A diagram label ".211 - 2001" means host ${CONSOLE_NETWORK_PREFIX}.211, port 2001
CONSOLE_NETWORK_PREFIX=10.22.9
ALLOWED_CONSOLE_HOSTS=10.22.9.211,10.22.9.212
ALLOWED_PORT_RANGE=2000-2099

# ── Teams and benches ────────────────────────────────────────────────────────
# A bench taken by a team is released after this many hours without activity
BENCH_IDLE_HOURS=3
# Reservation limits per team (admins are not bound by them): future slots,
# length of one slot in hours, and how far ahead a slot may be booked (days)
RESERVATION_MAX_FUTURE=2
RESERVATION_MAX_HOURS=4
RESERVATION_MAX_DAYS_AHEAD=14

# ── Bench jobs (backup, injection, reset) ───────────────────────────────────
# Devices one job works on at the same time (one console line each)
JOB_DEVICES_AT_ONCE=5
# A reset starts this many seconds after it is confirmed; anyone watching may cancel it meanwhile
JOB_COUNTDOWN_SECONDS=10
# Largest ZIP accepted when a snapshot or a TP template is imported (KB)
JOB_IMPORT_MAX_KB=2048
# The device driver's waiting budgets are multiplied by this. Keep 1 on the real
# lab (a reload may take fifteen minutes); the simulator boots in seconds, so a
# demonstration on the mock lab may use 0.05
JOB_TIME_SCALE=1
# The script library, device notes, bench chat and browser notifications
# (wave 3) have no setting: their limits are fixed (ARCHITECTURE §9)

# ── Limits ───────────────────────────────────────────────────────────────────
# Console lines open on the platform at once (several people on one line count once)
MAX_SESSIONS=40
# Consoles one signed-in user may have open at once (per user, whatever their address)
MAX_SESSIONS_PER_CLIENT=6
# A line nobody typed on for this long is hung up
IDLE_TIMEOUT_MINUTES=60
# Console lines sharing one SSH connection to the jump server; keep it below
# the jump server's sshd MaxSessions (10 by default)
SSH_CHANNELS_PER_CONNECTION=8

# ── Console journal ──────────────────────────────────────────────────────────
# What the devices printed (never keystrokes), with who held the keyboard;
# readable by the people who were there, their team and the admins. Read
# rights cover the whole day of a console: someone on any session of R1
# today reads every session of R1 today
JOURNAL_RETENTION_DAYS=14
# Size cap of one device's journal for one day, in KB
JOURNAL_MAX_KB_PER_DAY=5120
# Size cap of every journal together, in MB: past it, the oldest days go first
JOURNAL_MAX_TOTAL_MB=1024

# ── Infrastructure section ───────────────────────────────────────────────────
# Admin switches (same jump server → telnet path as the lab devices). The
# starting list: once edited from Administration > Admin switches, the list
# in the database (DATA_DIR/lab-console.db) wins
INFRA_CONFIG_PATH=./config/infrastructure.json

# ── Credential set 3: Proxmox VE API (ticket authentication) ─────────────────
# Proxmox is on the isolated lab network: the platform reaches it ONLY through
# the SSH jump server above (SSH_*), by port forwarding
# Leave PROXMOX_URL empty to run without Proxmox (admin switches still work)
PROXMOX_URL=https://<IP_PROXMOX>:8006
PROXMOX_USERNAME=<USERNAME>
PROXMOX_REALM=pve
PROXMOX_PASSWORD=<PASSWORD>
# Optional, recommended: pin Proxmox's (self-signed) certificate
# On the Proxmox node:  openssl x509 -in /etc/pve/local/pve-ssl.pem -noout -fingerprint -sha256
PROXMOX_FINGERPRINT=
