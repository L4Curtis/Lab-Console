# ─────────────────────────────────────────────────────────────────────────────
# Lab Console configuration
# Copy to .env and fill in the values
# ─────────────────────────────────────────────────────────────────────────────

# ── Web server ───────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
# Public address of the platform, as users type it: scheme and host, no path.
# Required when AUTH_MODE=on (sign-in redirects and cookie security derive from it)
PUBLIC_URL=
# Reverse proxies (nginx, Traefik, a Cloudflare tunnel…) whose X-Forwarded-For
# header is believed: comma list of IP addresses and CIDR blocks, IPv4 or IPv6.
# Everyone else's header is ignored, so nobody can fake their address.
# Empty = the platform is reached directly.   e.g. 192.168.10.112,172.16.0.0/12
TRUSTED_PROXIES=
# Legacy switch: true believes X-Forwarded-For from ANY peer. Prefer
# TRUSTED_PROXIES, which wins when both are set
TRUST_PROXY=false
# Language of the interface on a first visit: fr or en. Each user can switch;
# the choice is remembered in their browser
DEFAULT_LOCALE=fr
DIAGRAM_PATH=./diagrams/diagram.drawio
# Where the platform keeps its state (sessions, audit trail, backups…). The
# only directory it writes to; must be writable by the service account.
# Default ./data; the Docker image sets /data and expects a volume there
# DATA_DIR=./data

# ── Sign-in ──────────────────────────────────────────────────────────────────
# on  - every page, API call and console needs a signed-in user (default).
#       This build does not include the sign-in module yet: it refuses to
#       start with "on" rather than run open by accident
# off - no login, as in v1: every visitor is an anonymous administrator.
#       Only behind something that already controls who gets in
AUTH_MODE=on

# ── Credential set 1: SSH jump server ────────────────────────────────────────
SSH_HOST=<IP_ADDRESS>
SSH_PORT=<SSH_PORT>
SSH_USERNAME=<USERNAME>
SSH_PASSWORD=<PASSWORD>
# Optional, recommended: pin the jump server's host key
# Get it with:  ssh-keyscan -t ed25519 <IP_ADDRESS> | ssh-keygen -lf -
SSH_HOST_FINGERPRINT=
# Optional: key authentication instead of SSH_PASSWORD
# SSH_PRIVATE_KEY_PATH=./keys/id_ed25519
# SSH_KEY_PASSPHRASE=
# How the Proxmox tunnel crosses the jump server (device consoles are unaffected):
#   auto    - use TCP forwarding; if the jump server forbids it ("open failed" /
#             administratively prohibited), fall back to a relay command. Default.
#   forward - TCP forwarding only (needs AllowTcpForwarding on the jump server)
#   exec    - always run a relay command (socat/nc/bash), like the consoles do
# PROXMOX_TUNNEL_TRANSPORT=auto
# Optional explicit relay for exec/auto, with {host}/{port}. Empty = auto-detect
# (prefers socat, then ncat, nc, then bash /dev/tcp).
# PROXMOX_TUNNEL_RELAY=socat - TCP:{host}:{port}

# ── Credential set 2: Telnet console login ───────────────────────────────────
# Sent automatically to the first Username:/Password: prompt of a console line
# Leave TELNET_USERNAME empty for lines that only ask for a password
TELNET_USERNAME=<USERNAME_TELNET>
TELNET_PASSWORD=<PASSWORD_TELNET>
TELNET_AUTOLOGIN=true
# Silent console lines get one Enter after this much idle time (ms), but only
# if no login:/Password:/device prompt is visible (0 disables the nudge)
TELNET_WAKE_IDLE_MS=2500

# ── Which consoles may be reached ────────────────────────────────────────────
# A diagram label ".211 - 2001" means host ${CONSOLE_NETWORK_PREFIX}.211, port 2001
CONSOLE_NETWORK_PREFIX=10.22.9
ALLOWED_CONSOLE_HOSTS=10.22.9.211,10.22.9.212
ALLOWED_PORT_RANGE=2000-2099

# ── Limits ───────────────────────────────────────────────────────────────────
MAX_SESSIONS=40
MAX_SESSIONS_PER_CLIENT=6
IDLE_TIMEOUT_MINUTES=60

# ── Infrastructure section ───────────────────────────────────────────────────
# Admin switches (same jump server → telnet path as the lab devices)
INFRA_CONFIG_PATH=./config/infrastructure.json

# ── Credential set 3: Proxmox VE API (ticket authentication) ─────────────────
# Proxmox is on the isolated lab network: the platform reaches it ONLY through
# the SSH jump server above (SSH_*), by port forwarding
# Leave PROXMOX_URL empty to run without Proxmox (admin switches still work)
PROXMOX_URL=https://<IP_PROXMOX>:8006
PROXMOX_USERNAME=<USERNAME>
PROXMOX_REALM=pve
PROXMOX_PASSWORD=<PASSWORD>
# Optional, recommended: pin Proxmox's (self-signed) certificate
# On the Proxmox node:  openssl x509 -in /etc/pve/local/pve-ssl.pem -noout -fingerprint -sha256
PROXMOX_FINGERPRINT=
